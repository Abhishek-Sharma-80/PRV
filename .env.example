# Environment Configuration for PRV Consultancy Services

# Database Configuration (PostgreSQL for Vercel Production, SQLite fallback if empty)
# Example for Neon/Supabase/Vercel Postgres:
# DATABASE_URL=postgres://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=

# AI Model Configuration (Groq Cloud LLM for Ultra-Fast AI Assistant)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
GEMINI_API_KEY=

# Admin Authentication & Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_SECRET=prv_consultancy_secure_session_secret_2026

# Server Configuration
PORT=3000
